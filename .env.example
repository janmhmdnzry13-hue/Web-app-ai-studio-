# Server-Side Secrets (Never expose with VITE_ prefix)
# GEMINI_API_KEY: Required for Gemini AI API calls. Managed via Settings / Secrets in AI Studio.
GEMINI_API_KEY=

# Authentication & Encryption Secrets
JWT_SECRET=
ENCRYPTION_SECRET=

# Monetization & Stripe Billing (Optional - fallback sandbox enabled when not set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Application URL (Injected at runtime by hosting container)
APP_URL=

# Transactional Email Delivery (Optional - fallback sandbox logger enabled when not set)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_WEBHOOK_URL=

